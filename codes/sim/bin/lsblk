#!/usr/bin/env python3
"""Fake `lsblk` for the b2ctl sim — emits `-P` KEY="value" rows from state.

In RAID mode the front-panel drives live behind the PERC virtual disk and are
invisible to the OS; lsblk then shows only the VD block device (model 'PERC …')
plus the OS-visible back-panel NVMe drives, so the RAID backend synthesises its
members/UGood drives from perccli instead of double-counting lsblk rows (F-115).
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
import _simstate as S  # noqa: E402

def _vd_blockdevs():
    """One block device per synthetic VD (names chosen not to collide with a real
    sim disk); model triggers hba_raid._is_perc_vd, WWN carries the VD's NAA so
    the per-VD device map can join them (F-136)."""
    return [{"name": v["dev"], "size": v["bytes"], "serial": "", "tran": "sas",
             "rota": 0, "model": "PERC H730P Mini", "wwn": "0x" + v["naa"],
             "mount": v.get("mount", ""), "fssize": v.get("fssize"),
             "fsused": v.get("fsused")}
            for v in S.RAID_VDS]


def _emit(d, fields):
    vals = {
        "NAME": d["name"], "SIZE": str(d["size"]), "SERIAL": d.get("serial", ""),
        "MODEL": d["model"], "TRAN": d["tran"], "ROTA": str(d["rota"]),
        "TYPE": "disk", "WWN": d.get("wwn", ""),
        # Filesystem columns: only the VD block devices carry them, so
        # blockdev.vd_usage() gets a DIFFERENT answer per volume (F-136).
        "MOUNTPOINT": d.get("mount", ""),
        "FSSIZE": str(d["fssize"]) if d.get("fssize") else "",
        "FSUSED": str(d["fsused"]) if d.get("fsused") else "",
    }
    print(" ".join(f'{f}="{vals.get(f, "")}"' for f in fields))


def main():
    argv = sys.argv[1:]
    cols = "NAME"
    if "-o" in argv:
        cols = argv[argv.index("-o") + 1]
    fields = [c.strip() for c in cols.split(",")]
    state = S.load()
    dev_arg = next((a for a in argv if a.startswith("/dev/")), None)

    if dev_arg is not None:
        # Targeted query (e.g. vd_usage) — passthrough, no RAID remodeling.
        want = dev_arg.replace("/dev/", "")
        for d in state["disks"] + _vd_blockdevs():
            if d.get("present", True) and d["name"] == want:
                _emit(d, fields)
        return 0

    raid = state.get("mode") == "raid"
    hidden = {d["name"] for d in S.raid_pds(state)} if raid else set()
    for d in state["disks"]:
        if not d.get("present") or d["name"] in hidden:
            continue
        _emit(d, fields)
    if raid:
        for vd in _vd_blockdevs():    # the VDs the front drives hide behind
            _emit(vd, fields)
    return 0


if __name__ == "__main__":
    sys.exit(main())
